NODE_ENV=development
PORT=6060
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:6060

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ticketx

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

SEAT_LOCK_TTL_SECONDS=600

PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret

GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# MAIL_PASS must be a Google "App Password" (16 chars, no spaces), not your
# regular Gmail password — Google has blocked plain-password SMTP since 2022.
# Requires 2-Step Verification enabled first: myaccount.google.com/security
# Generate one at: myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM=TicketX <no-reply@ticketx.dev>

OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
